<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oscardo_cream"
    android:orientation="vertical"
    tools:context=".profile.ProfileFragment">

    <include
        android:id="@+id/appBar"
        layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AO"
                    android:textSize="36sp"
                    android:textColor="@color/oscardo_white"
                    android:fontFamily="@font/poppins_semibold" />
            </FrameLayout>

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aldo Alvaro" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Android Developer • SIPEKA SO" />

            <!-- Card Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/oscardo_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Text.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tentang Saya"
                        android:textColor="@color/oscardo_green" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mahasiswa yang sedang membangun aplikasi SIPEKA Salon Oscardo. Fokus pada clean UI, Material Design 3, dan pengalaman pengguna yang nyaman." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/oscardo_line" />

                    <TextView
                        style="@style/Text.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sosial Media"
                        android:textColor="@color/oscardo_green" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• Instagram : @aldo._.alvaro\n• GitHub    : github.com/aldoalvaro\n• LinkedIn  : linkedin.com/in/aldoalvaro\n• Email     : aldo24ti@mahasiswa.pcr.ac.id" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/oscardo_line" />

                    <TextView
                        style="@style/Text.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hobi"
                        android:textColor="@color/oscardo_green" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• Mendesain UI/UX\n• Vibe Coding\n• Main Game\n• Mendengarkan musik saat coding" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/oscardo_line" />

                    <TextView
                        style="@style/Text.BodyBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kekuatan Terbesar"
                        android:textColor="@color/oscardo_green" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Konsistensi dalam menulis kode yang rapi, mengikuti design system (color palette Oscardo + font Poppins), dan selalu memikirkan alur pengguna dari Splash → Login → Dashboard, serta tak lupa menggunakan ai semaksimal mungkin." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Color Palette: oscardo_green • oscardo_cream • oscardo_red"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>