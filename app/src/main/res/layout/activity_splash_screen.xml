<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/oscardo_green">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/logo_oscardo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Salon Oscardo"
        android:textColor="@color/oscardo_white"
        android:textSize="28sp"
        android:fontFamily="@font/poppins_semibold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SIPEKA • Manajemen Salon"
        android:textColor="@color/oscardo_green_light"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="v1.0"
        android:textColor="@color/oscardo_green_light"
        android:textSize="12sp" />
</LinearLayout>