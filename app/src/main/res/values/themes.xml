<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- GRAND DESIGN: Font.
         Heading  : Playfair Display Bold (sementara memakai serif sistem sampai file font ditambahkan)
         Body     : Plus Jakarta Sans    (sementara memakai Poppins bawaan proyek)
         Untuk mengganti font, cukup ubah 3 baris di bagian "Font" di bawah ini. -->
    <style name="Font.Heading" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.SalonOscardo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/oscardo_green</item>
        <item name="colorOnPrimary">@color/oscardo_white</item>
        <item name="colorPrimaryContainer">@color/oscardo_green_light</item>
        <item name="colorOnPrimaryContainer">@color/oscardo_green_dark</item>
        <item name="colorSecondary">@color/oscardo_red</item>
        <item name="colorOnSecondary">@color/oscardo_white</item>
        <item name="colorSurface">@color/oscardo_white</item>
        <item name="colorOnSurface">@color/oscardo_ink</item>
        <item name="colorError">@color/oscardo_red</item>
        <item name="android:colorBackground">@color/oscardo_cream</item>
        <item name="android:windowBackground">@color/oscardo_cream</item>
        <item name="android:statusBarColor">@color/oscardo_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Font body -->
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Teks -->
    <style name="Text.Heading" parent="Font.Heading">
        <item name="android:textColor">@color/oscardo_ink</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/oscardo_gray</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/oscardo_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="Text.BodyBold" parent="Text.Body">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- Toolbar -->
    <style name="TextAppearance.Oscardo.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/oscardo_white</item>
    </style>
    <style name="Widget.Oscardo.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/oscardo_green</item>
        <item name="titleTextAppearance">@style/TextAppearance.Oscardo.ToolbarTitle</item>
        <item name="titleTextColor">@color/oscardo_white</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- Tombol -->
    <style name="Widget.Oscardo.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/oscardo_green</item>
        <item name="android:textColor">@color/oscardo_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.Oscardo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/oscardo_green</item>
        <item name="strokeColor">@color/oscardo_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Input -->
    <style name="Widget.Oscardo.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/oscardo_white</item>
        <item name="boxStrokeColor">@color/oscardo_green</item>
        <item name="hintTextColor">@color/oscardo_green</item>
        <item name="startIconTint">@color/oscardo_gray</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Kartu -->
    <style name="Widget.Oscardo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/oscardo_white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>
</resources>
